{
  "plugins": ["nx/plugins/package-json"],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.env.schema",
        "{workspaceRoot}/.env",
        "{workspaceRoot}/.env.local"
      ],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.cache/tsbuildinfo.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/.cache/tsbuildinfo.json"]
    },
    "format": {
      "cache": true
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "migration:create": {
      "cache": false
    },
    "migration:up": {
      "cache": false
    }
  },
  "defaultBase": "master",
  "analytics": false
}
