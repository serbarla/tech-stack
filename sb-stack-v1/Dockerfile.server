FROM node:22.23.4 AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json ./
COPY .env.schema ./
COPY apps apps
COPY packages packages
COPY tooling tooling
RUN pnpm install --frozen-lockfile

FROM oven/bun:1.4.4 AS run
WORKDIR /app
COPY --from=deps /app ./
# No frozen env: `varlock/auto-load` resolves config at boot via the varlock CLI,
# with process env (AUTH_SECRET/BETTER_AUTH_URL/PORT from compose) winning over
# .env.schema defaults. DATABASE_URL is @dynamic=boot and raw-read by the
# migration CMD, so it stays a plain ENV pointing at the compose volume.
ENV DATABASE_URL=/data/sqlite.db
ENV NODE_ENV=production
RUN mkdir -p /data && chown bun:bun /data
EXPOSE 3000
USER bun
CMD ["sh", "-c", "cd packages/db && bunx --bun mikro-orm migration:up && cd /app && exec bun apps/server/src/index.ts"]
