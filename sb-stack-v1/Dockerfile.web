FROM node:22.23.4 AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json ./
COPY .env.schema ./
COPY apps apps
COPY packages packages
COPY tooling tooling
RUN pnpm install --frozen-lockfile
# Same-origin deployments: set VITE_API_URL to this origin (e.g. http://host:3001)
# at web build time so the bundle calls /api on the nginx proxy. Required — a
# production bundle must never silently default to http://localhost:3000.
ARG VITE_API_URL
RUN test -n "$VITE_API_URL" || (echo "VITE_API_URL build-arg is required" && exit 1)
RUN pnpm nx run @acme/web:build

FROM nginx:1.30.6-alpine AS run
COPY nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist/client /usr/share/nginx/html
